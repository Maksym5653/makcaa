<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070710"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Логотип -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐾"
        android:textSize="52sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CatGuard"
        android:textColor="#FFFFFF"
        android:textSize="38sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Охорона для вашого кота"
        android:textColor="#6677AA"
        android:textSize="15sp"
        android:layout_marginBottom="52dp"/>

    <!-- Camera Mode -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="#0F1A2A"
        app:cardElevation="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷  Camera Mode"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Трансляція · Виявлення кота · Мікрофон · 4K"
                android:textColor="#6677AA"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnCamera"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Запустити камеру"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#1565C0"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Viewer Mode -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="18dp"
        app:cardBackgroundColor="#0F1A1A"
        app:cardElevation="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖥  Viewer Mode"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="До 4 камер · Тривога ESP32 · Звук · QR"
                android:textColor="#336655"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnViewer"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Відкрити монітор"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:backgroundTint="#1B5E20"
                    android:layout_marginEnd="10dp"/>

                <Button
                    android:id="@+id/btnQr"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="📷"
                    android:textSize="20sp"
                    android:backgroundTint="#0D3D27"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ESP32 hint -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESP32: підключіться до CatGuard_WiFi (password123)"
        android:textColor="#334455"
        android:textSize="11sp"
        android:layout_marginTop="8dp"/>

</LinearLayout>
